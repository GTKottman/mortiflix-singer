{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mortiflix Singer",
  "version": "0.1.0",
  "identifier": "com.mortiflix.singer",
  "build": { "frontendDist": "../../web" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Singing voice synthesizer",
    "longDescription": "Write notes and words and hear them sung; record your own voice and train a singer from it.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/singer-service"],
    "licenseFile": "../../LICENSE",
    "macOS": { "minimumSystemVersion": "11.0", "infoPlist": "Info.plist" },
    "linux": { "deb": { "depends": [] } }
  }
}
